{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-harness.dev/contracts/v2/managed-state-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "runtimeReadiness": { "type": "array", "maxItems": 0 }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "desiredState": {
            "type": "object",
            "required": ["profileId", "selectedAgents"],
            "properties": {
              "profileId": { "const": "mds-host" },
              "selectedAgents": { "type": "array", "maxItems": 0 }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "runtimeReadiness": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "catalogRevision",
    "planDigest",
    "appliedAt",
    "completedActionIds",
    "desiredState",
    "startupConsent",
    "runtimeReadiness",
    "ownership"
  ],
  "properties": {
    "$schema": {
      "const": "../contracts/managed-state-receipt.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "managed-state-receipt"
    },
    "catalogRevision": {
      "$ref": "#/$defs/sha256"
    },
    "planDigest": {
      "$ref": "#/$defs/sha256"
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedActionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/actionId"
      }
    },
    "desiredState": {
      "$ref": "#/$defs/desiredState"
    },
    "startupConsent": {
      "$ref": "#/$defs/startupConsent"
    },
    "runtimeReadiness": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtimeReadiness"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownership"
      }
    },
    "releaseChannels": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/releaseChannel"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agentId": {
      "enum": ["claude-code", "opencode", "codex"]
    },
    "desiredState": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyDesiredState"
        },
        {
          "$ref": "#/$defs/explicitDesiredState"
        }
      ]
    },
    "legacyDesiredState": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "profileId": { "const": "mds-host" } }
          },
          "else": {
            "type": "object",
            "properties": {
              "selectedAgents": { "type": "array", "minItems": 1 }
            }
          }
        }
      ],
      "required": ["profileId", "selectedAgents"],
      "properties": {
        "profileId": {
          "$ref": "#/$defs/stableId"
        },
        "selectedAgents": {
          "$ref": "#/$defs/selectedAgents"
        },
        "runtimeAddons": {
          "$ref": "#/$defs/runtimeAddonPins"
        }
      }
    },
    "explicitDesiredState": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "profileId": { "const": "mds-host" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "selectedPackages": { "type": "array", "maxItems": 0 },
              "toolRoutes": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "selectedAgents": { "type": "array", "minItems": 1 }
            }
          }
        }
      ],
      "required": [
        "profileId",
        "selectedAgents",
        "instance",
        "capabilitySet",
        "selectedCapabilities",
        "selectedPackages",
        "toolRoutes"
      ],
      "properties": {
        "profileId": {
          "$ref": "#/$defs/stableId"
        },
        "selectedAgents": {
          "$ref": "#/$defs/selectedAgents"
        },
        "instance": {
          "$ref": "#/$defs/environmentInstance"
        },
        "capabilitySet": {
          "enum": ["profile", "workflow-only"]
        },
        "selectedCapabilities": {
          "$ref": "#/$defs/selectedCapabilities"
        },
        "selectedPackages": {
          "$ref": "#/$defs/selectedPackages"
        },
        "toolRoutes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRoute"
          }
        },
        "runtimeAddons": {
          "$ref": "#/$defs/runtimeAddonPins"
        }
      }
    },
    "runtimeAddonPins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/runtimeAddonPin"
      }
    },
    "runtimeAddonPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "id", "kind", "version", "fingerprint"],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "id": {
          "const": "omo"
        },
        "kind": {
          "enum": ["opencode-package", "codex-marketplace"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selectedAgents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/agentId"
      }
    },
    "selectedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "lsp-jdtls",
          "lsp-kotlin",
          "lsp-csharp",
          "lsp-clangd",
          "lsp-gopls",
          "lsp-pyright",
          "lsp-typescript",
          "goal",
          "deep-research",
          "ideation",
          "brainstorm",
          "plan",
          "code-review",
          "doc-review",
          "skill-creator",
          "ralph-loop",
          "security-guidance"
        ]
      }
    },
    "selectedPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["notion", "linear", "jira", "confluence", "github", "gitlab"]
      }
    },
    "environmentInstance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "transport", "platform", "stateRoot"],
          "properties": {
            "id": {
              "const": "windows-native"
            },
            "transport": {
              "const": "local"
            },
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "arch"],
              "properties": {
                "os": {
                  "const": "win32"
                },
                "arch": {
                  "enum": ["arm64", "x64"]
                }
              }
            },
            "stateRoot": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "transport", "distribution", "platform", "stateRoot"],
          "properties": {
            "id": {
              "const": "wsl-ubuntu"
            },
            "transport": {
              "const": "wsl"
            },
            "distribution": {
              "const": "Ubuntu"
            },
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["os", "arch"],
              "properties": {
                "os": {
                  "const": "linux"
                },
                "arch": {
                  "enum": ["arm64", "x64"]
                }
              }
            },
            "stateRoot": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "toolRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "targetInstanceId", "receiptFingerprint"],
      "properties": {
        "packageId": {
          "enum": ["notion", "linear", "jira", "confluence", "github", "gitlab"]
        },
        "targetInstanceId": {
          "const": "wsl-ubuntu"
        },
        "receiptFingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "startupConsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repairPinned",
        "addReviewedContent",
        "channelId",
        "profileId",
        "artifactClasses",
        "permissionScopes"
      ],
      "properties": {
        "repairPinned": {
          "type": "boolean"
        },
        "addReviewedContent": {
          "type": "boolean"
        },
        "channelId": {
          "$ref": "#/$defs/stableId"
        },
        "profileId": {
          "$ref": "#/$defs/stableId"
        },
        "artifactClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "managed-skill",
              "plugin",
              "hook",
              "mcp-server",
              "lsp-binary",
              "external-command",
              "package-script"
            ]
          }
        },
        "permissionScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "state"],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "state": {
          "enum": ["ready", "pending", "unsupported", "unverifiable"]
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "target", "digest"],
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["repairSource"]
          },
          "then": {
            "type": "object",
            "properties": {
              "scope": {
                "const": "managed"
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/actionId"
        },
        "kind": {
          "enum": ["file", "directory", "registration", "executable"]
        },
        "scope": {
          "enum": ["external", "managed"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "repairSource": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releaseChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "manifestDigest"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
