{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-harness.dev/contracts/v2/release-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "channel",
    "sequence",
    "catalogRevision",
    "compatibility",
    "distribution",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "../contracts/release-catalog.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "release-catalog"
    },
    "channel": {
      "$ref": "#/$defs/stableId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "catalogRevision": {
      "$ref": "#/$defs/sha256"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "version", "tag", "archiveFilename", "sidecarFilename"],
      "properties": {
        "packageName": { "const": "oh-my-harness" },
        "version": { "$ref": "#/$defs/version" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "archiveFilename": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz$" },
        "sidecarFilename": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+\\.release\\.json$" }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "kind", "package", "source", "catalogRevision", "archive"],
      "properties": {
        "$schema": { "const": "harness/contracts/release-catalog.schema.json#/$defs/releaseSidecar" },
        "schemaVersion": { "const": "2.0.0" },
        "kind": { "const": "release-sidecar" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "tag"],
          "properties": {
            "name": { "const": "oh-my-harness" },
            "version": { "$ref": "#/$defs/version" },
            "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree"],
          "properties": {
            "commit": { "$ref": "#/$defs/gitObject" },
            "tree": { "$ref": "#/$defs/gitObject" }
          }
        },
        "catalogRevision": { "$ref": "#/$defs/sha256" },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "size", "sha256", "files"],
          "properties": {
            "filename": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz$" },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/archiveFile" }
            }
          }
        }
      }
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "archiveFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "mode", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^package/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._+/-]+$" },
        "size": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "channelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schemaVersion",
        "kind",
        "id",
        "audience",
        "bootstrapTrust",
        "automaticAdditions",
        "requireExactDigest",
        "allowMutableReferences"
      ],
      "properties": {
        "$schema": {
          "const": "../contracts/release-catalog.schema.json#/$defs/channelPolicy"
        },
        "schemaVersion": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "release-channel-policy"
        },
        "id": {
          "const": "stable"
        },
        "audience": {
          "const": "oh-my-harness-v2"
        },
        "bootstrapTrust": {
          "$ref": "#/$defs/bootstrapTrust"
        },
        "automaticAdditions": {
          "const": ["managed-skill"]
        },
        "requireExactDigest": {
          "const": true
        },
        "allowMutableReferences": {
          "const": false
        }
      }
    },
    "bootstrapTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceId"],
      "properties": {
        "kind": {
          "const": "embedded"
        },
        "sourceId": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCliVersion", "maximumCliVersion"],
      "properties": {
        "minimumCliVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "maximumCliVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "digest", "sourceId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": ["catalog", "managed-skill", "plugin"]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "sourceId": {
          "$ref": "#/$defs/stableId"
        }
      }
    }
  }
}
